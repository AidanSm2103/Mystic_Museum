<header>
  <a class="brand" href="/">
  <img src="/images/logo.png" alt="Mystic Museum" class="brand-logo">
  </a>
  <div class="header-right">
    <nav>
      <a href="/" class="<%= active === 'home' ? 'active' : '' %>">Home</a>
      <a href="/exhibits" class="<%= active === 'exhibits' ? 'active' : '' %>">Exhibits</a>
      <a href="/about" class="<%= active === 'about' ? 'active' : '' %>">About</a>
      <a href="/notes" class="<%= active === 'notes' ? 'active' : '' %>">Curator's Notes</a>
    </nav>
    <span class="rune-counter">RUNES FOUND: <b><%= unlockedCount %></b> / <%= totalArtifacts %></span>
  </div>

  <% if (active === 'exhibits' && typeof isUnlocked === 'function' && !isUnlocked('loom')) { %>
    <form method="POST" action="/unlock/loom">
      <button type="submit" class="rune-hidden" style="top:14px; left:2px; width:22px; height:22px;" aria-label="A faint rune. Something is carved here."><%- runeSVG(artifactsBySlug['loom'].runeKey, 'var(--gold-bright)') %></button>
    </form>
  <% } %>

  <% if (active === 'notes' && typeof isUnlocked === 'function' && !isUnlocked('astrolabe')) { %>
    <form method="POST" action="/unlock/astrolabe">
      <button type="submit" class="rune-hidden" style="top:16px; right:2px; width:22px; height:22px;" aria-label="A faint rune. Something is carved here."><%- runeSVG(artifactsBySlug['astrolabe'].runeKey, 'var(--gold-bright)') %></button>
    </form>
  <% } %>
</header>